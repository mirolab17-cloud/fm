rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function role() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role; }
    match /persons/{personId}/{file} {
      allow read: if request.auth != null && role() in ['viewer', 'editor', 'admin'];
      allow write: if request.auth != null && role() in ['editor', 'admin']
        && request.resource.size < 3 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp|gif)');
      allow delete: if request.auth != null && role() == 'admin';
    }
    match /docs/{file} {
      allow read: if request.auth != null && role() in ['viewer', 'editor', 'admin'];
      allow write: if request.auth != null && role() in ['editor', 'admin'] && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp|gif)|text/plain)');
      allow delete: if request.auth != null && role() == 'admin';
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
